# ============================================================
# Navi AI Career & Study Companion — .env.example
# Salin ke .env.local (lokal) lalu isi. JANGAN commit .env.local.
# [WAJIB] = harus diisi, [OPSIONAL] = boleh kosong.
# ============================================================

# ---------- App ----------
# [WAJIB] URL publik app. Lokal: http://localhost:3000, Vercel: https://<domain>.vercel.app
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---------- Database: Turso (libSQL) ----------
# [WAJIB] `turso db show morriztech --url` -> libsql://morriztech-kenzyplay.<region>.turso.io
TURSO_DATABASE_URL=libsql://morriztech-kenzyplay.aws-ap-southeast-1.turso.io
# [WAJIB] `turso db tokens create morriztech` (server-only, jangan pakai prefix NEXT_PUBLIC_)
TURSO_AUTH_TOKEN=

# ---------- Auth: Better Auth ----------
# [WAJIB] Random 32+ byte: `openssl rand -base64 32`
BETTER_AUTH_SECRET=
# [WAJIB] Base URL untuk Better Auth (biasanya sama dengan NEXT_PUBLIC_APP_URL)
BETTER_AUTH_URL=http://localhost:3000
# [OPSIONAL] Login Google — https://console.cloud.google.com/apis/credentials
#   Redirect URI: <BETTER_AUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---------- AI: Gemini (@google/genai) ----------
# [WAJIB] https://aistudio.google.com/apikey (server-only). Tanpa ini chat pakai jawaban fixture.
GEMINI_API_KEY=
# [OPSIONAL] Default di kode: gemini-3.6-flash (sudah ada sebelumnya — tetap dipakai)
GEMINI_MODEL=gemini-3.6-flash

# ---------- Email (reset password, verifikasi, pengingat) ----------
# [WAJIB untuk reset password & reminder] https://resend.com/api-keys
RESEND_API_KEY=
# [WAJIB jika RESEND dipakai] Pengirim dari domain terverifikasi di Resend (atau onboarding@resend.dev untuk tes)
EMAIL_FROM="Navi <onboarding@resend.dev>"

# ---------- Reminder harian (Vercel Cron) ----------
# [WAJIB di production] Random string; Vercel Cron kirim header Authorization: Bearer <CRON_SECRET>
CRON_SECRET=

# ---------- Rate limit /api/chat ----------
# [OPSIONAL] Batas pesan per user per jendela waktu (default 20 / 60 detik). Disimpan di tabel Turso rate_limits.
CHAT_RATE_LIMIT_MAX=20
CHAT_RATE_LIMIT_WINDOW_SECONDS=60

# ============================================================
# HAPUS (Supabase lama — tidak dipakai setelah migrasi ke Turso)
# ============================================================
# NEXT_PUBLIC_SUPABASE_URL=            # HAPUS
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY= # HAPUS
# SUPABASE_SECRET_KEY=                 # HAPUS
